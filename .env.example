# Copiar a .env y ajustar los valores antes de levantar los contenedores.
# El archivo .env NO se versiona.

POSTGRES_DB=sistema
POSTGRES_USER=sistema
POSTGRES_PASSWORD=cambia_esto
POSTGRES_PORT=5432

TZ=America/Lima

# Usuario principal que el backend crea al arrancar si la tabla usuario está vacía.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_esto_tambien

# Carpeta local donde viven las llaves JWT (generarlas con scripts/generate-jwt-keys).
JWT_KEYS_DIR=./backend/keys

# true solamente cuando el sistema se publique con HTTPS.
APP_AUTH_COOKIE_SECURE=false
